      "cues": [
        {
          "start": 0.5,
          "end": 8,
          "text": "那天的晚饭，比平时安静。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.8181148852479815,
          "seconds": 2.6,
          "sha256": "86226b66d51b86b9e77b5972303072e131a7ed2e7045e628a55bed7821500371"
        },
        {
          "start": 8.3,
          "end": 14,
          "text": "她看着桌上的菜。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.8457534099245907,
          "seconds": 1.68346875,
          "sha256": "c649d787d6f05cb2191c094956ba52d9b6ed68c3c97c82a28fe905daa5179140"
        },
        {
          "start": 14.3,
          "end": 24,
          "text": "他把那盘菜，慢慢推了过去。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.796892656210223,
          "seconds": 2.9,
          "sha256": "7ad63ab3b744770c35ff725ab11d8884ff3d0f11785948bdf07052ee4a637d6c"
        },
        {
          "start": 24.3,
          "end": 30,
          "text": "过了一会儿，她把碗递了回来。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.7605140394956874,
          "seconds": 2.6586875,
          "sha256": "0aac425ddc7962dcef4ba7227bd270491b1ffc2838ec4341673b887ae660e6fa"
        },
        {
          "start": 30.3,
          "end": 36,
          "text": "再给我盛一点吧。",
          "role": "woman",
          "voice": "Chinese (Mandarin)_Warm_Bestie",
          "speed": 0.96,
          "gain": 2.1863344031558616,
          "seconds": 1.68346875,
          "sha256": "5db94959ef4f56b151427847d6614e202fde729d9a216590197331d661db83e1"
        }
      ]
    },
    "newcomer": {
      "file": "newcomer.11337f44760b.wav",
