      "cues": [
        {
          "start": 0.5,
          "end": 9,
          "text": "第一天，他端着杯子，站在聊天声外面。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.800099456389006,
          "seconds": 3.99384375,
          "sha256": "b05643948793fcc2774238d6fe1b5194e1df5e8f6d64f3a2731b7863ace8920c"
        },
        {
          "start": 9.3,
          "end": 17,
          "text": "想说些什么，又怕打断别人。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.7992883552263317,
          "seconds": 2.9,
          "sha256": "4ef9844757d56226d9aebd9de625cb2145b1e3cdeebbb41fe1352a9643b7c631"
        },
        {
          "start": 17.3,
          "end": 25,
          "text": "你也刚搬来？过来一起聊。",
          "role": "colleague",
          "voice": "Chinese (Mandarin)_Sincere_Adult",
          "speed": 0.96,
          "gain": 2.4012743767038267,
          "seconds": 2.4845625,
          "sha256": "0cad4f244e67b5fa5b6eb187b9b46295f3d526b0614530689fb5fd80f10cf359"
        },
        {
          "start": 25.2,
          "end": 32,
          "text": "有人侧了侧身，留出了一个位置。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.7528068722598356,
          "seconds": 2.97215625,
          "sha256": "8e2c07400cf071e4748cf690b31d89b404a7dd205f9bc316f946b880c468bd56"
        },
        {
          "start": 32.1,
          "end": 36,
          "text": "半步的空隙，刚好容得下一个人。",
          "role": "narrator",
          "voice": "Chinese (Mandarin)_Gentleman",
          "speed": 0.96,
          "gain": 0.8482678444376456,
          "seconds": 3.1463125,
          "sha256": "9e6cd7931a99941b2b973a4eb5e8d755072df19f6167602ad6716a99fef6dfdf"
        }
